FROM python:3.12.14-slim-trixie

# Note:     When run by the Data Manager the uid and gid
#           will be set according to the Project we're running against.
#           Consequently we cannot know in advance the user or group id
#           for execution, and so we must ensure the code runs
#           as any user.

# libxrender1, libxext6 and libexpat1 are needed by rdkit.Chem.Draw, which
# Fragmenstein imports. procps is needed by Nextflow's task monitoring.
RUN apt-get -y update &&\
 apt-get -y install --no-install-recommends\
 procps\
 libxrender1\
 libxext6\
 libexpat1 &&\
 apt-get clean -y

ENV PYTHONUNBUFFERED=1

ENV HOME=/code
WORKDIR ${HOME}

COPY requirements.txt ./

# Fragmenstein brings its own RDKit and NumPy, so the versions of those are
# left to it rather than pinned here.
RUN pip install --no-cache-dir -r requirements.txt
